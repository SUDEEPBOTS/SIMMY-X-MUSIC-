# Mandatory Telegram API Credentials (Obtain from https://my.telegram.org)
API_ID=
API_HASH=

# Mandatory Telegram Bot Token (Obtain from @BotFather on Telegram)
BOT_TOKEN=

# Bot Administrative Configuration
OWNER_ID=                             # Your numeric Telegram user ID (e.g. 6889753421)
OWNER_USERNAME=heartstealer_x         # Your Telegram username without @
LOGGER_ID=                            # Telegram Supergroup ID with -100 prefix for activity logs

# Database Connection (MongoDB Atlas free tier: https://cloud.mongodb.com)
MONGO_DB_URI=                         # mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Pyrogram v2 Assistant String Session (Generate via session generator bot)
STRING_SESSION=

# Optional Music Resolvers (Spotify Developer Dashboard: https://developer.spotify.com)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Bot Customization & Limits
DURATION_LIMIT=17000                  # Maximum allowed track duration in minutes
PLAYLIST_FETCH_LIMIT=25               # Maximum tracks to queue from a single playlist URL
AUTO_LEAVING_ASSISTANT=False          # Automatically remove assistant from idle voice chats

# Cloud Deployment & Git Sync
UPSTREAM_REPO=https://github.com/SUDEEPBOTS/SIMMY-X-MUSIC-
UPSTREAM_BRANCH=main
SUPPORT_CHANNEL=https://t.me/heartstealer_x
SUPPORT_CHAT=https://t.me/+N08m5L1mCTU2NTE1
